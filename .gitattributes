# .gitattributes
# Force LF for deterministic JSON / TOML / YAML / Markdown / Python so that
# fixture bytes and contract hashes are identical across Windows and Linux.
# Only PowerShell scripts are kept on CRLF.

*               text=auto eol=lf

*.json          text eol=lf
*.toml          text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.md            text eol=lf
*.py            text eol=lf
*.pyi           text eol=lf
*.sh            text eol=lf
*.bash          text eol=lf

*.ps1           text eol=crlf
