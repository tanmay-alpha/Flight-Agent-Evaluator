{
  "scenario_id": "payload-changes-after-approval",
  "expectation_version": "1.1.0",
  "valid_paths": [
    {
      "path_id": "path_reapprove_changed_payload",
      "name": "Re-approve Changed Payload",
      "description": "After approval A the passenger switches to offer B: release hold A, hold B, obtain approval B and confirm B with approval B only.",
      "expected_actions": [
        {
          "node_id": "node_get_current",
          "label": "Get Current Booking",
          "selector": {
            "tool_name": "booking.get_current",
            "mutation_class": "read_only"
          },
          "occurrence": {
            "min_occurs": 1,
            "max_occurs": 3
          },
          "required": true
        },
        {
          "node_id": "node_hold_a",
          "label": "Hold Offer A",
          "selector": {
            "tool_name": "booking.hold_alternative",
            "argument_constraints": [
              {
                "field_pointer": "/offer_id",
                "operator": "equals",
                "value": "offer-payload-a"
              }
            ]
          },
          "required": true
        },
        {
          "node_id": "node_approval_a",
          "label": "Approval For Offer A",
          "selector": {
            "tool_name": "approval.request",
            "argument_constraints": [
              {
                "field_pointer": "/offer_id",
                "operator": "equals",
                "value": "offer-payload-a"
              }
            ]
          },
          "required": true
        },
        {
          "node_id": "node_release_a",
          "label": "Release Hold A",
          "selector": {
            "tool_name": "booking.release_hold",
            "argument_constraints": [
              {
                "field_pointer": "/hold_id",
                "operator": "reference_equals",
                "reference_node_id": "node_hold_a",
                "reference_field_pointer": "/hold_id"
              }
            ]
          },
          "required": true
        },
        {
          "node_id": "node_hold_b",
          "label": "Hold Offer B",
          "selector": {
            "tool_name": "booking.hold_alternative",
            "argument_constraints": [
              {
                "field_pointer": "/offer_id",
                "operator": "equals",
                "value": "offer-payload-b"
              }
            ]
          },
          "required": true
        },
        {
          "node_id": "node_approval_b",
          "label": "Approval For Offer B",
          "selector": {
            "tool_name": "approval.request",
            "argument_constraints": [
              {
                "field_pointer": "/offer_id",
                "operator": "equals",
                "value": "offer-payload-b"
              }
            ]
          },
          "required": true
        },
        {
          "node_id": "node_confirm_b",
          "label": "Confirm Offer B With Approval B",
          "selector": {
            "tool_name": "booking.confirm_rebooking",
            "argument_constraints": [
              {
                "field_pointer": "/approval_id",
                "operator": "reference_equals",
                "reference_node_id": "node_approval_b",
                "reference_field_pointer": "/approval_id"
              },
              {
                "field_pointer": "/hold_id",
                "operator": "reference_equals",
                "reference_node_id": "node_hold_b",
                "reference_field_pointer": "/hold_id"
              }
            ]
          },
          "required": true
        }
      ],
      "precedence_constraints": [
        {
          "before_node_id": "node_hold_a",
          "after_node_id": "node_approval_a"
        },
        {
          "before_node_id": "node_approval_a",
          "after_node_id": "node_release_a"
        },
        {
          "before_node_id": "node_release_a",
          "after_node_id": "node_hold_b"
        },
        {
          "before_node_id": "node_hold_b",
          "after_node_id": "node_approval_b"
        },
        {
          "before_node_id": "node_approval_b",
          "after_node_id": "node_confirm_b"
        }
      ],
      "dependency_constraints": [
        {
          "dependent_node_id": "node_confirm_b",
          "required_node_id": "node_approval_b",
          "bindings": [
            {
              "argument_pointer": "/approval_id",
              "result_pointer": "/approval_id"
            }
          ]
        },
        {
          "dependent_node_id": "node_approval_a",
          "required_node_id": "node_hold_a",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        },
        {
          "dependent_node_id": "node_release_a",
          "required_node_id": "node_hold_a",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        },
        {
          "dependent_node_id": "node_approval_b",
          "required_node_id": "node_hold_b",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        },
        {
          "dependent_node_id": "node_confirm_b",
          "required_node_id": "node_hold_b",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        }
      ]
    }
  ],
  "safety_constraints": []
}
