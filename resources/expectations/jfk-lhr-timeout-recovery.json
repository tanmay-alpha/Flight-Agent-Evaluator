{
  "scenario_id": "jfk-lhr-timeout-recovery",
  "expectation_version": "1.0.0",
  "valid_paths": [
    {
      "path_id": "path_timeout_recovery",
      "name": "Timeout Recovery Path",
      "description": "Retries or queries backup status lookup following a simulated tool fault.",
      "expected_actions": [
        {
          "node_id": "node_status_initial",
          "label": "Initial Status Attempt",
          "selector": {
            "tool_name": "flight.get_status",
            "mutation_class": "read_only"
          },
          "expected_result_status": "error",
          "required": true
        },
        {
          "node_id": "node_status_retry",
          "label": "Status Retry",
          "selector": {
            "tool_name": "flight.get_status",
            "mutation_class": "read_only"
          },
          "expected_result_status": "success",
          "required": true
        },
        {
          "node_id": "node_search_flights",
          "label": "Search Alternative Flights",
          "selector": {
            "tool_name": "flight.search_flights",
            "mutation_class": "read_only"
          },
          "expected_result_status": "success",
          "required": true
        }
      ],
      "precedence_constraints": [
        {
          "before_node_id": "node_status_initial",
          "after_node_id": "node_status_retry",
          "description": "Initial status attempt before retry"
        },
        {
          "before_node_id": "node_status_retry",
          "after_node_id": "node_search_flights",
          "description": "Status retry before search"
        }
      ],
      "dependency_constraints": [
        {
          "dependent_node_id": "node_status_retry",
          "required_node_id": "node_status_initial"
        }
      ]
    }
  ]
}
