{
  "schema_version": "1.0.0",
  "scenario_id": {
    "id": "jfk-lhr-delay",
    "version": 1
  },
  "metadata": {
    "title": "JFK-LHR delayed departure scenario",
    "description": "A baseline scenario where the agent checks the status of AS142 departing JFK for LHR on 2026-07-28.",
    "objective": "Demonstrate end-to-end determinism: run → replay → verify"
  },
  "limits": {
    "tool_call_limit": 10,
    "time_limit_seconds": 120
  },
  "seed": 42,
  "steps": [
    {
      "step_id": "check-flight-status",
      "description": "Check the status of AS142 on 2026-07-28"
    }
  ],
  "assertions": [
    {
      "assertion_id": "status-lookup-called",
      "assertion_type": "tool_called",
      "tool_name": "flight.get_status"
    },
    {
      "assertion_id": "search-called",
      "assertion_type": "tool_called",
      "tool_name": "flight.search_flights"
    },
    {
      "assertion_type": "no_duplicate_side_effect",
      "assertion_id": "no-mutation",
      "tool_name": "flight.get_status"
    },
    {
      "assertion_type": "replay_determinism",
      "assertion_id": "replay-determinism"
    }
  ],
  "faults": [],
  "trajectory": {
    "trajectory_id": "jfk-lhr-delay-trajectory",
    "description": "Standard delay investigation for AS142 JFK→LHR",
    "steps": [
      {
        "kind": "invoke_tool",
        "step_id": "step-1-status",
        "tool_name": "flight.get_status",
        "arguments": {
          "flight_id": "AS142",
          "operating_day": "2026-07-28"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-2-search",
        "tool_name": "flight.search_flights",
        "arguments": {
          "origin": "JFK",
          "destination": "LHR",
          "departure_date": "2026-07-28"
        }
      },
      {
        "kind": "produce_final_response",
        "step_id": "step-3-response",
        "response": "AS142 is delayed. Alternative flights are available from JFK to LHR."
      }
    ]
  }
}