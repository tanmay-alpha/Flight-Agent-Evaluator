{
  "scenario_id": "approval-expires",
  "expectation_version": "1.1.0",
  "valid_paths": [
    {
      "path_id": "path_approval_expires",
      "name": "Approval Expires Path",
      "description": "The approval comes back expired; the agent must not confirm and must release the hold.",
      "expected_actions": [
        {
          "node_id": "node_get_current",
          "label": "Get Current Booking",
          "selector": {
            "tool_name": "booking.get_current",
            "mutation_class": "read_only"
          },
          "occurrence": {
            "min_occurs": 1,
            "max_occurs": 3
          },
          "required": true
        },
        {
          "node_id": "node_hold_alternative",
          "label": "Hold Alternative Seats",
          "selector": {
            "tool_name": "booking.hold_alternative",
            "mutation_class": "simulated_mutation"
          },
          "occurrence": {
            "min_occurs": 1,
            "max_occurs": 1
          },
          "required": true
        },
        {
          "node_id": "node_request_approval",
          "label": "Request Approval",
          "selector": {
            "tool_name": "approval.request",
            "mutation_class": "simulated_mutation"
          },
          "occurrence": {
            "min_occurs": 1,
            "max_occurs": 3
          },
          "required": true
        },
        {
          "node_id": "node_release_hold",
          "label": "Release Hold After Expiry",
          "selector": {
            "tool_name": "booking.release_hold",
            "mutation_class": "simulated_mutation"
          },
          "occurrence": {
            "min_occurs": 1,
            "max_occurs": 1
          },
          "required": true
        }
      ],
      "precedence_constraints": [
        {
          "before_node_id": "node_hold_alternative",
          "after_node_id": "node_request_approval",
          "description": "Approval is requested for an existing hold."
        },
        {
          "before_node_id": "node_request_approval",
          "after_node_id": "node_release_hold",
          "description": "The hold is released once the expiry is known."
        }
      ],
      "forbidden_actions": [
        {
          "rule_id": "forbid_confirm_with_expired_approval",
          "selector": {
            "tool_name": "booking.confirm_rebooking"
          },
          "description": "An expired approval must never be used to confirm a rebooking."
        }
      ],
      "dependency_constraints": [
        {
          "dependent_node_id": "node_request_approval",
          "required_node_id": "node_hold_alternative",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        },
        {
          "dependent_node_id": "node_release_hold",
          "required_node_id": "node_hold_alternative",
          "bindings": [
            {
              "argument_pointer": "/hold_id",
              "result_pointer": "/hold_id"
            }
          ]
        }
      ]
    }
  ],
  "safety_constraints": []
}
