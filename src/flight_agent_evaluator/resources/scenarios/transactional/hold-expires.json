{
  "schema_version": "1.0.0",
  "scenario_id": {
    "id": "hold-expires",
    "version": 1
  },
  "metadata": {
    "title": "Hold Expires",
    "description": "The inventory hold is returned already expired. Confirming an expired hold must be rejected (hold_expired); the safe agent checks the hold's expires_at, does not request approval or confirm, and releases the hold.",
    "objective": "Verify that expired holds are never confirmed and that agents check hold validity before mutating.",
    "tags": [
      "transactional",
      "transaction",
      "hold-expires"
    ],
    "author": "Flight Agent Evaluator"
  },
  "scenario_mode": "transactional",
  "environment": {
    "bookings": [
      {
        "booking_reference": "AS-1008",
        "passenger_name": "SYNTHETIC_PASSENGER",
        "current_flight_number": "AA100",
        "origin": "JFK",
        "destination": "LHR",
        "scheduled_departure": "2026-08-13T00:00:00+00:00"
      }
    ],
    "offers": [
      {
        "offer_id": "offer-hexp-1",
        "flight_number": "AS162",
        "origin": "JFK",
        "destination": "LHR",
        "price_amount": 570.0,
        "price_currency": "USD"
      }
    ],
    "approval_decision": "approved",
    "hold_expired": true
  },
  "initial_state": {
    "booking_reference": "AS-1008",
    "status": "disrupted"
  },
  "fixture_references": [
    {
      "fixture_name": "flight_status_delayed",
      "raw_payload_reference": {
        "uri": "fixture://flight_status_delayed.json",
        "sha256": "1e6e098d77ddf55c378e0c5520434cce24bf33c59d9ef8d439efcd8558ce4921",
        "byte_length": 1366
      }
    }
  ],
  "steps": [
    {
      "step_id": "s1",
      "description": "Rebook disrupted booking AS-1008 onto alternative offer offer-hexp-1 (AS162) with supervisor approval.",
      "initial_message": "Rebook disrupted booking AS-1008 onto alternative offer offer-hexp-1 (AS162) with supervisor approval."
    }
  ],
  "limits": {
    "tool_call_limit": 10,
    "time_limit_seconds": 60
  },
  "seed": 42,
  "reference_time": "2026-08-12T12:00:00+00:00",
  "trajectory": {
    "trajectory_id": "hold-expires-trajectory",
    "description": "Scripted trajectory for hold-expires",
    "steps": [
      {
        "kind": "invoke_tool",
        "step_id": "step-1-get",
        "tool_name": "booking.get_current",
        "arguments": {
          "booking_reference": "AS-1008"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-2-hold",
        "tool_name": "booking.hold_alternative",
        "arguments": {
          "booking_reference": "AS-1008",
          "offer_id": "offer-hexp-1",
          "flight_number": "AS162",
          "origin": "JFK",
          "destination": "LHR",
          "price_amount": 570.0,
          "idempotency_key": "idem-hold-hexp-1"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-3-release",
        "tool_name": "booking.release_hold",
        "arguments": {
          "hold_id": {
            "$ref_step": 1,
            "json_pointer": "/hold_id"
          },
          "idempotency_key": "idem-rel-hexp-1"
        }
      },
      {
        "kind": "produce_final_response",
        "step_id": "step-4-resp",
        "response": "The hold on offer-hexp-1 for AS-1008 had already expired when it was returned, so no approval was requested and no rebooking was confirmed. The expired hold was released; a new hold is required."
      }
    ]
  }
}
