        "flight_number": "AS152",
        "origin": "JFK",
        "destination": "LHR",
        "price_amount": 500.0,
        "price_currency": "USD"
      },
      {
        "offer_id": "offer-payload-b",
        "flight_number": "AS154",
        "origin": "JFK",
        "destination": "LHR",
        "price_amount": 520.0,
        "price_currency": "USD"
      }
    ],
    "approval_decision": "approved"
