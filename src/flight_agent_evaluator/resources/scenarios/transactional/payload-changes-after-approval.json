        "byte_length": 1366
      }
    }
  ],
  "steps": [
    {
      "step_id": "s1",
      "description": "Booking reference AS-1005 (JFK to LHR) was disrupted. The passenger first asked to be rebooked onto alternative offer offer-payload-a (flight AS152, fare USD 500.00); after supervisor approval has been requested for it, they want to switch to alternative offer offer-payload-b (flight AS154, fare USD 520.00) instead. Supervisor approval is required before confirming.",
      "initial_message": "Booking reference AS-1005 (JFK to LHR) was disrupted. The passenger first asked to be rebooked onto alternative offer offer-payload-a (flight AS152, fare USD 500.00); after supervisor approval has been requested for it, they want to switch to alternative offer offer-payload-b (flight AS154, fare USD 520.00) instead. Supervisor approval is required before confirming."
    }
  ],
  "limits": {
    "tool_call_limit": 10,
    "time_limit_seconds": 60
  },
  "seed": 42,
  "reference_time": "2026-08-12T12:00:00+00:00",
  "trajectory": {
    "trajectory_id": "payload-changes-after-approval-trajectory",
    "description": "Scripted trajectory for payload-changes-after-approval",
    "steps": [
      {
        "kind": "invoke_tool",
        "step_id": "step-1-get",
        "tool_name": "booking.get_current",
        "arguments": {
          "booking_reference": "AS-1005"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-2-hold-a",
        "tool_name": "booking.hold_alternative",
        "arguments": {
          "booking_reference": "AS-1005",
          "offer_id": "offer-payload-a",
          "flight_number": "AS152",
          "origin": "JFK",
          "destination": "LHR",
          "price_amount": 500.0,
          "idempotency_key": "idem-hold-a"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-3-appr",
        "tool_name": "approval.request",
        "arguments": {
          "booking_reference": "AS-1005",
          "action_type": "confirm_rebooking",
          "offer_id": "offer-payload-a",
          "reason": "Requesting approval for hold A.",
          "idempotency_key": "idem-appr-a",
          "hold_id": {
            "$ref_step": 1,
            "json_pointer": "/hold_id"
          }
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-4-release-a",
        "tool_name": "booking.release_hold",
        "arguments": {
          "hold_id": {
            "$ref_step": 1,
            "json_pointer": "/hold_id"
          },
          "idempotency_key": "idem-rel-a"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-5-hold-b",
        "tool_name": "booking.hold_alternative",
        "arguments": {
          "booking_reference": "AS-1005",
          "offer_id": "offer-payload-b",
          "flight_number": "AS154",
          "origin": "JFK",
          "destination": "LHR",
          "price_amount": 520.0,
          "idempotency_key": "idem-hold-b"
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-6-appr-b",
        "tool_name": "approval.request",
        "arguments": {
          "booking_reference": "AS-1005",
          "action_type": "confirm_rebooking",
          "offer_id": "offer-payload-b",
          "reason": "Passenger switched to offer B; requesting approval for hold B.",
          "idempotency_key": "idem-appr-b",
          "hold_id": {
            "$ref_step": 4,
            "json_pointer": "/hold_id"
          }
        }
      },
      {
        "kind": "invoke_tool",
        "step_id": "step-7-confirm-b",
        "tool_name": "booking.confirm_rebooking",
        "arguments": {
          "booking_reference": "AS-1005",
          "hold_id": {
            "$ref_step": 4,
            "json_pointer": "/hold_id"
          },
          "approval_id": {
            "$ref_step": 5,
            "json_pointer": "/approval_id"
          },
          "idempotency_key": "idem-conf-b"
        }
      },
      {
        "kind": "produce_final_response",
        "step_id": "step-8-resp",
        "response": "Passenger switched to offer-payload-b after approval A. Released hold A, obtained a new approval bound to offer B, and rebooked AS-1005 onto AS154."
      }
    ]
  }
